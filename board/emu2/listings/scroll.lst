00C1 8|0|0|2|0000  LOAD A, [X]
00C2 9|0|0|1|0208  STORE [t], A
00C3 8|0|0|1|0207  LOAD A, [cc]
00C4 0|0|8|0|0001  ADD #1
00C5 9|0|0|1|0207  STORE [cc], A
00C6 8|0|0|1|0208  LOAD A, [t]
00C7 F|4|0|0|0000  RET
                           ; Start-up routine: the CPU fills the four LOOKUP tables through the write ports TBL0..TBL3.
                           ; Table address = operand<<8 | A, so one pass over b (outer) and a (inner) writes every table
                           ; in order; each port auto-increments and wraps to 0 after 65536 writes.
                           ; Call once with interrupts off.  Destroys A, C.  Costs about 17 cycles per entry (1.1 M clocks).
                           .data
D 0900 00                   _t_b:   .byte 0
D 0901 00                   _t_lo:  .byte 0
D 0902 00                   _t_hi:  .byte 0
D 0903 00                   _t_q:   .byte 0
D 0904 00                   _t_r:   .byte 0
                           .code
                           init_tables:
00C8 8|0|0|0|0000  LOAD A, #0
00C9 9|0|0|1|0900  STORE [_t_b], A
00CA 8|0|0|0|0000  _t_row: LOAD A, #0
00CB 9|0|0|1|0901  STORE [_t_lo], A
00CC 9|0|0|1|0902  STORE [_t_hi], A
00CD 9|0|0|1|0904  STORE [_t_r], A
00CE 8|0|0|1|0900  LOAD A, [_t_b]
00CF 1|0|0|0|0000  CMP #0                  ; divide by zero row: quotient 255, remainder = A
00D0 8|0|0|0|0000  LOAD A, #0
00D1 C|5|0|0|00D3  JUMP NZ, _t_q0
00D2 8|0|0|0|00FF  LOAD A, #255
00D3 9|0|0|1|0903  _t_q0:  STORE [_t_q], A
00D4 8|0|1|0|0000  LOAD C, #0              ; DJNZ from 0 counts 256 entries
00D5 8|0|0|1|0901  _t_in:  LOAD A, [_t_lo]
00D6 9|0|0|1|FF30  STORE [TBL0], A         ; MUL   = low byte of a*b
00D7 0|0|8|1|0900  ADD [_t_b]              ; lo += b, carry out
00D8 9|0|0|1|0901  STORE [_t_lo], A
00D9 8|0|0|1|0902  LOAD A, [_t_hi]
00DA 9|0|0|1|FF31  STORE [TBL1], A         ; MULH  = high byte
00DB 0|0|8|8|0000  ADC #0                  ; hi += carry
00DC 9|0|0|1|0902  STORE [_t_hi], A
00DD 8|0|0|1|0903  LOAD A, [_t_q]
00DE 9|0|0|1|FF32  STORE [TBL2], A         ; DIV
00DF 8|0|0|1|0904  LOAD A, [_t_r]
00E0 9|0|0|1|FF33  STORE [TBL3], A         ; MOD
00E1 0|0|8|0|0001  ADD #1                  ; r + 1
00E2 1|0|0|1|0900  CMP [_t_b]              ; reached b? then r = 0 and q + 1
00E3 C|5|0|0|00E8  JUMP NZ, _t_nr
00E4 8|0|0|1|0903  LOAD A, [_t_q]
00E5 0|0|8|0|0001  ADD #1
00E6 9|0|0|1|0903  STORE [_t_q], A
00E7 8|0|0|0|0000  LOAD A, #0
00E8 9|0|0|1|0904  _t_nr:  STORE [_t_r], A
00E9 D|0|0|0|00D5  DJNZ _t_in
00EA 8|0|0|1|0900  LOAD A, [_t_b]
00EB 0|0|8|0|0001  ADD #1
00EC 9|0|0|1|0900  STORE [_t_b], A
00ED C|5|0|0|00CA  JUMP NZ, _t_row
00EE F|4|0|0|0000  RET

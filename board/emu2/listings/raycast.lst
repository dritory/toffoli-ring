01C7 F|4|0|0|0000  RET
                           ; Start-up routine: the CPU fills the four LOOKUP tables through the write ports TBL0..TBL3.
                           ; Table address = operand<<8 | A, so one pass over b (outer) and a (inner) writes every table
                           ; in order; each port auto-increments and wraps to 0 after 65536 writes.
                           ; Call once with interrupts off.  Destroys A, C.  Costs about 17 cycles per entry (1.1 M clocks).
                           .data
D 3000 00                   _t_b:   .byte 0
D 3001 00                   _t_lo:  .byte 0
D 3002 00                   _t_hi:  .byte 0
D 3003 00                   _t_q:   .byte 0
D 3004 00                   _t_r:   .byte 0
                           .code
                           init_tables:
01C8 8|0|0|0|0000  LOAD A, #0
01C9 9|0|0|1|3000  STORE [_t_b], A
01CA 8|0|0|0|0000  _t_row: LOAD A, #0
01CB 9|0|0|1|3001  STORE [_t_lo], A
01CC 9|0|0|1|3002  STORE [_t_hi], A
01CD 9|0|0|1|3004  STORE [_t_r], A
01CE 8|0|0|1|3000  LOAD A, [_t_b]
01CF 1|0|0|0|0000  CMP #0                  ; divide by zero row: quotient 255, remainder = A
01D0 8|0|0|0|0000  LOAD A, #0
01D1 C|5|0|0|01D3  JUMP NZ, _t_q0
01D2 8|0|0|0|00FF  LOAD A, #255
01D3 9|0|0|1|3003  _t_q0:  STORE [_t_q], A
01D4 8|0|1|0|0000  LOAD C, #0              ; DJNZ from 0 counts 256 entries
01D5 8|0|0|1|3001  _t_in:  LOAD A, [_t_lo]
01D6 9|0|0|1|FF30  STORE [TBL0], A         ; MUL   = low byte of a*b
01D7 0|0|8|1|3000  ADD [_t_b]              ; lo += b, carry out
01D8 9|0|0|1|3001  STORE [_t_lo], A
01D9 8|0|0|1|3002  LOAD A, [_t_hi]
01DA 9|0|0|1|FF31  STORE [TBL1], A         ; MULH  = high byte
01DB 0|0|8|8|0000  ADC #0                  ; hi += carry
01DC 9|0|0|1|3002  STORE [_t_hi], A
01DD 8|0|0|1|3003  LOAD A, [_t_q]
01DE 9|0|0|1|FF32  STORE [TBL2], A         ; DIV
01DF 8|0|0|1|3004  LOAD A, [_t_r]
01E0 9|0|0|1|FF33  STORE [TBL3], A         ; MOD
01E1 0|0|8|0|0001  ADD #1                  ; r + 1
01E2 1|0|0|1|3000  CMP [_t_b]              ; reached b? then r = 0 and q + 1
01E3 C|5|0|0|01E8  JUMP NZ, _t_nr
01E4 8|0|0|1|3003  LOAD A, [_t_q]
01E5 0|0|8|0|0001  ADD #1
01E6 9|0|0|1|3003  STORE [_t_q], A
01E7 8|0|0|0|0000  LOAD A, #0
01E8 9|0|0|1|3004  _t_nr:  STORE [_t_r], A
01E9 D|0|0|0|01D5  DJNZ _t_in
01EA 8|0|0|1|3000  LOAD A, [_t_b]
01EB 0|0|8|0|0001  ADD #1
01EC 9|0|0|1|3000  STORE [_t_b], A
01ED C|5|0|0|01CA  JUMP NZ, _t_row
01EE F|4|0|0|0000  RET
